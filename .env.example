# Cabinhug 环境变量样例。
# 复制为仓库根 .env 后填入真实值；服务与 cockpit 均会自动加载（已存在的环境变量优先）。
# 真实密钥不入库（.gitignore 已覆盖 .env / .env.*）。

# ── 数据库（infra/docker-compose.yml，宿主端口 55433 避开本机已占用端口）
DATABASE_URL="postgresql://carlife:carlife@localhost:55433/carlife"
# 测试专用库，与开发库物理分开：同一个 PG 容器、另一个库。
# 跑测试前先建一次：`corepack pnpm db:test:setup`（幂等，可反复跑）。
#
# 分开的原因：e2e 的准备阶段会 deleteMany 掉 demo-user 的车辆与行程，
# 而 `demo:seed` 播的是同一个 userId，共用一个库时跑一次端到端演示数据就被清空。
#
# 库名必须以 `_test` 结尾，否则测试拒绝运行（直接退出，不是警告），
# 防止它被指回开发库。不配则用下面这个默认值。
TEST_DATABASE_URL="postgresql://carlife:carlife@localhost:55433/carlife_test"

# ── LLM（§5.1：Vercel AI SDK + DeepSeek；缺省时 runtime 用确定性 Fake 模型）
DEEPSEEK_API_KEY=""
# CABINHUG_LLM=fake            # 强制离线 Fake（开发/测试）

# ── 视觉观察层（ACR-024）：拍照问诊的「看图」适配器，走 OpenAI 兼容口
# CABINHUG_VISION=dashscope            # dashscope（密钥 DASHSCOPE_API_KEY）| deepseek（密钥 DEEPSEEK_API_KEY）| fake（按图片哈希回放 fixtures/by-sha）| off（观察节点直通并写 caveat）
# CABINHUG_VISION_DETECT_MODEL="qwen3-vl-flash"    # 第一遍整图检测（便宜档，定位准）
# CABINHUG_VISION_DESCRIBE_MODEL="qwen3-vl-plus"   # 第二遍逐 crop 描述（实测零错）
# 两遍可以来自两家：定位与描述的强项不在同一家——同一份提示词、同一张 tesla-01，
#   qwen3-vl-plus 的 bbox 平均 IoU 0.936，DeepSeek v4.1-flash 只有 0.643（它按约 800×800 等效像素下采样，
#   坐标精度受结构限制）；描述那一遍则是 DeepSeek 更稳、且快两个数量级。缺省两遍都是 dashscope。
# CABINHUG_VISION_DETECT_PROVIDER=""   # dashscope | deepseek | yolo；空 = 缺省档（ACR-045）：VISION_TRAINER_URL 与 CABINHUG_VISION_YOLO_MODEL 都配了就是 yolo，
#                                     #   否则退回 CABINHUG_VISION 那一家并在启动日志说明"云端定位已退役，仅作兜底"。端上带框（detections）时这一遍不被调用。
#                                     #   yolo = 端侧检测器只做定位，
#                                     #   经 VISION_TRAINER_URL 的 POST /predict 推理，第二遍仍交给下面那家
# CABINHUG_VISION_DESCRIBE_PROVIDER="" # dashscope | deepseek；`verifyPair`（成对核验）跟着描述那一遍走。不能是 yolo
# CABINHUG_VISION_YOLO_MODEL=""        # 选了 yolo 必填：训练任务 id（vision-trainer GET /models 的 id）
# CABINHUG_VISION_YOLO_CONF=0.3        # yolo 置信阈值；G 版权重 0.3 与 0.25 认对相同、多报更少
# CABINHUG_VISION_YOLO_IMGSZ=960       # yolo 推理边长 = 训练尺寸；1280 误报翻倍、1600 以上零框（实测）
# CABINHUG_VISION_FIXTURES=""          # fake 档 fixture 目录，缺省 evals/vision-observe/fixtures/by-sha
# CABINHUG_ICON_IMAGES_ROOT=""        # 手册图标图片根目录；空 = 仓库内 data/kb-src/icons。取不到 → 不做成对核验，匹配只能说「疑似」
# CABINHUG_ALERT_CATALOG_ROOT=""      # 官方警报代码表目录（tesla-alerts.json，kb:alerts 生成）；空 = 仓库内 data/kb-src/alerts。取不到 → 警报只有屏幕原话
# VISION_TRAINER_URL=""              # 检测器训练服务（ACR-026，内部工具）；空 = 未启用；只应指向 localhost，如 http://localhost:8799
#                                    #   它同时是观察层 yolo 档的 /predict 地址。容器栈里 runtime 的这个值由 compose 覆盖成 http://vision-infer:8799
#                                    #   （ACR-050：线上只跑推理服务，onnxruntime + 与端上同一份 ONNX）；这里的 localhost 在容器里指向容器自身，
#                                    #   连接被拒时每张不带框的照片整图降级。连通性用 corepack pnpm probe:vision-infer 查。
# CABINHUG_ICON_INDEX=on               # 手册图标图文索引（ACR-025）：on | off（off 时 caveats 写「图标未能与手册对上」）
# CABINHUG_ICON_EMBED_MODEL="qwen3-vl-embedding"   # 换模型要 kb:icons --rebuild 整表重建（维度可能变）
# CABINHUG_KB_FIGURES=off              # 手册图文索引（ACR-029）：on | off（缺省 off；on 要 DASHSCOPE_API_KEY 且 kb:figures 建过索引）
# CABINHUG_KB_FIGURES_STORE=pgvector  # 图文索引后端（ACR-030）：pgvector（缺省，库内表）| qdrant（独立服务）。连不上 Qdrant 会自动退回 pgvector
# QDRANT_URL=""                      # 图文索引 Qdrant 地址（ACR-030）；空 = http://127.0.0.1:6333。本机档无鉴权且只绑 127.0.0.1
# QDRANT_API_KEY=""                  # 非本机部署必填；本机档留空
# CABINHUG_KB_FIGURES_ROOT=""          # kb:convert 落盘的手册图片目录；空 = 仓库内 data/kb-figures。取不到图片只给文字段、不挂图

# ── ASR：豆包 omni（火山方舟 Ark；缺省时用 Fake）
ARK_API_KEY=""
# ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_ASR_MODEL="doubao-seed-2-0-mini-260428"
# ASR_ENGINE=fake             # 测试专用：固定文本、不看音频（仅 env 注入，不进后台下拉）
# CABINHUG_ASR_FAKE_TEXT="…"   # fake 档固定返回文本
#
# 本地 ASR 档（ACR-007：容器内 llama.cpp + Qwen3-ASR-0.6B GGUF）：
# 不依赖第三方账号余额，也不依赖 Host 二进制。模型是两个 GGUF 文件（主模型 + mmproj），
# 先准备模型并启用 Compose profile：
#   corepack pnpm dev:asr:setup
#   corepack pnpm dev:start local-asr
# 或直接运行 dev:bootstrap；它会在 local 模式下先校验模型，再启动并等待容器。
# 默认模型目录与 setup 工具一致（目录名沿用 whisper-models，避免重新缓存）；
# 需要改目录时两边都读取这个变量。
# WHISPER_MODEL_DIR="/absolute/path/to/whisper-models"  # 不填则使用用户缓存目录
# 然后放开下面这行（mock = 本机容器档）。
# .env 写了 ASR_ENGINE 即钉死档位：后台该项变只读（source 显示 env），
# 需要热切时不在这里写。钉死用于账号欠费或配置层故障时由部署层兜底。
# ASR_ENGINE=mock            # mock=local-asr 容器（真模型跑本机）；与 TTS_ENGINE=mock 不是同一个服务
# 宿主 Gateway 访问 Compose 发布端口（llama-server 的 OpenAI 风格转写端点）：
# LOCAL_ASR_URL="http://127.0.0.1:8795/v1/audio/transcriptions"
# 本地档强制语种，默认 Chinese（Qwen3-ASR 自动判语种时，噪声段可能输出任意语种）；
# 强制中文时网关同时启用 CJK 守门——整段无中文字符的输出按非语音丢弃。
# 置空回到自动判定并关闭守门：
# LOCAL_ASR_LANGUAGE=""
#
# ── 阿里云百炼档（ACR-015；ASR 与 TTS 共用一把 key）
# ASR 的 vendor 由后台「系统配置 → ASR」的 ASR_ENGINE 热切（ark｜aliyun｜mock）；
# .env 里写 ASR_ENGINE 即钉死（ACR-017，见上）。
DASHSCOPE_API_KEY=""
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
# ALIYUN_ASR_MODEL="qwen3-asr-flash"          # 同步档；-filetrans 异步档要公网 URL，不要换
# ALIYUN_TTS_MODEL="qwen3-tts-flash"
# ALIYUN_TTS_VOICE="Cherry"
#
# ── 日用量闸门（ACR-016；真相源在 DB，后台可热改，这里只是初值）
# 云厂商只有预算告警，没有按金额自动停用，硬闸由本仓设置。0 = 不限（默认）。
# 超限不是拒绝而是降级：ASR 落本地档（免费）、TTS 端上落系统 say。
# 它不是账单上限：只限制本仓一侧的调用量，供应商余额仍需单独关注。
# ASR_DAILY_CALL_LIMIT=0            # 云 ASR 每日调用次数；大头是哨兵唤醒词转写
# TTS_DAILY_CHAR_LIMIT=80000        # 云 TTS 每日合成字符；三档都经网关（ACR-018），
#                                   # 这个闸对 doubao 也生效。默认 80000（约 52 元/天），
#                                   # 写 0 = 不限

# ── TTS：豆包 seed-tts-2.0（字节 openspeech）——服务端配置，端上不读
# 合成全部经网关 /v1/tts/speech（ACR-018），密钥只在服务端使用；车机/手机
# 不持有任何 vendor 密钥（真机上也没有 .env）。
# 边收边播：off=等这一轮文字全部返回再分段合成播报；
# 置 on 则模型每吐出一句就送去合成，首声约等于「说完第一句」而不是「说完整段」。
# 默认 off：它改变的是开口时机，听感需要在真车上判断。后台可热切，端上约 30s 生效。
# TTS_STREAM_SPEECH=off
# 密钥只在后台把 TTS_ENGINE 切到 doubao 时才被用到；默认档是 mock，
# 这里可以留空（mock 档网关自动补占位值，整条 HTTP 链照常跑）。
# 切到豆包而这里没配时，网关拒绝合成并回错误行，端上据此降级系统 TTS，
# 不会拿占位值去调用计费接口。
BYTEDANCE_TTS_API_KEY=""
# BYTEDANCE_TTS_RESOURCE_ID="seed-tts-2.0"
# BYTEDANCE_TTS_SPEAKER="zh_female_vv_uranus_bigtts"   # 音色见火山文档 6561/1871062
# CARLIFE_TTS 已退役（ACR-017）：要立即停止播报用车机设置页的「播报开关」（热生效）；
# 选引擎用后台 TTS_ENGINE；网关不可达时端上自动降级系统 say（免费），不回落
# 本地环境变量里的端点。say 的音色仍可配：
# CABINHUG_TTS_SAY_VOICE="Tingting"
#
# ── 端侧语音的本地开关（车机/手机自己的表现，服务端不读）
# 这三项走 clients/*/src-tauri/src/dev_env.rs 的客户端白名单，只在 `tauri dev`
# 时从仓库根 .env 载入；打包分发的客户端不读 .env（真机上没有这个文件）。
#
# 放开时不要在值后面接行内注释：该加载器只做 trim + 去引号，不识别 `#`，
#    `CABINHUG_AEC_ENABLED=1  # 开` 会被读成值 `1  # 开`，判等 "1" 失败，
#    AEC 不启用、启用提示日志不出现，也不报错。
#
# 声学回声消除总开关（ACR-010）。默认关：开启后采集帧才过 AEC。
# 调参期它是工程开关不是用户偏好，所以只读环境变量、不做端上偏好页，重启生效。
# CABINHUG_AEC_ENABLED=1
#
# 覆盖平台默认 stream delay，调参时无需每扫一档就重编译。
# auto = 按平台默认；非法值只打一行告警并回落默认，不会启动失败。
# iOS 传不进环境变量，那边只能改 aec_bridge.rs 的常量重装。
# CABINHUG_AEC_DELAY_MS=auto
#
# 哨兵排障：打逐条转写与判定（含 dur / truncated），以及每 5s 一行 AEC 状态
# （fed / dropped / 播放中 / 帧长）。
# 只在开发机开启，车上不开：它会把未命中唤醒词的转写正文打进日志，
#    而 AC-52-5 要求那些内容判定后即弃、不留任何副本。
# CABINHUG_SENTINEL_DEBUG=1
#
# ── TTS 引擎开关（后台「系统配置 → TTS」可热切，这里只是初值）
# 真相源是 DB：后台改完约 30s 内端上自动切换，不必重启客户端，也不必改本文件。
# 默认 mock：开发期的默认值不使用计费引擎。
# .env 写了 TTS_ENGINE 即钉死档位（ACR-017，同 ASR_ENGINE），需要热切时不写：
# TTS_ENGINE=mock                   # mock=mocks/tts（本机 say 包装成豆包协议，8794，不计费）
#                                   #   ——与 ASR_ENGINE=mock 不是同一个服务：那个跑的是真模型
#                                   # ｜doubao=豆包（按字计费）
#                                   # ｜aliyun=百炼 qwen3-tts-flash（按字符计费，走网关门面，密钥不下端）
# MOCK_TTS_URL="http://localhost:8794/api/v3/tts/unidirectional"
#
# ── mock-tts：本机 `say` 假扮 seed-tts-2.0（mocks/tts，仅 macOS；
# 其它平台 dev.sh 默认不起它，TTS 走豆包或百炼）
# 与端上 say 降级路径的区别是它走完整条网络链：请求体形状 / NDJSON 分帧 /
# base64 拼接 / mp3 解码 / afplay 播放。端上降级 say 在发 HTTP 之前就短路，
# 覆盖不到这条链。
# 它与 ASR_ENGINE=mock 的 local-asr 容器是两个不同的服务。
# 用法：起 mock-tts，引擎在后台选（默认就是 mock）。不需要任何密钥：
# mock 只校验请求头带没带 Key、不校验值，端上会自动补占位值。
MOCK_TTS_PORT=8794
#
# 车机不用它做兜底（ACR-017）：网关不可达时直接降级系统 say（免费），
# 不回落 TtsClient 的默认端点（该默认端点是计费的豆包）。
# 端上不读它，也没有自行拼端点的能力。本行只服务于服务端：
# mock 档的上游地址由 MOCK_TTS_URL / 本行提供，由网关调用。
BYTEDANCE_TTS_URL="http://localhost:8794/api/v3/tts/unidirectional"
# MOCK_TTS_SAY_VOICE="Tingting"     # 覆盖音色映射；不设则按 speaker 里的性别词猜

# ── 服务端口（与 infra/scripts/dev.sh 的就绪检查、Compose 对外端口同一口径：
# gateway 8790 / runtime 8791。dev.sh 按这两个端口探活，改动要三处同步。）
GATEWAY_PORT=8790
# 只绑这个地址（ACR-062）。不设 = 所有网卡；单机版由宿主设 127.0.0.1。
# GATEWAY_BIND=127.0.0.1
# 不读仓库根的 .env（ACR-062）。单机版宿主在仓库检出里调试时设它；平时不用。
# CABINHUG_SKIP_ROOT_ENV=1
AGENT_RUNTIME_PORT=8791
AGENT_RUNTIME_URL="http://localhost:8791"
# runtime 的监听地址。默认 0.0.0.0，容器部署必须保持默认：gateway 经 docker
# 网络按服务名访问它（AGENT_RUNTIME_URL=http://agent-runtime:8791），绑回环会
# 断开这条链。容器里的暴露面由 compose 的 `expose`（而非 `ports`）控制。
# 开发机在公共网络时打开下面这行收紧：/internal/* 没有鉴权，0.0.0.0 意味着
# 同一段 Wi-Fi 上的任何人都能访问它。
# AGENT_RUNTIME_BIND=127.0.0.1
CABINHUG_GATEWAY_URL="http://localhost:8790"

# ── Agent 运行时开关（都有代码内默认值，列在这里是让模板与读取点一一对应）
# CABINHUG_AGENT_RUNTIME=acp     # acp=经 pi/ACP（默认）｜direct=直连 LLM 不走 pi
# CABINHUG_ANSWER_RUNTIME=acp    # 表述路径（与上面是两回事）：direct=answer 节点直连 narrator
# CABINHUG_ANSWER_MODEL=""       # direct 表述模型，默认 deepseek-flash
# CABINHUG_SERVICE_ASKS=on       # 问诊轮的「配合请求」提议：与应答并发的一次直连调用，模型提单选 / 多选 / 开放题 /
#                               #   操作引导 / 拍照，由预算器裁决后进诊断报告的 prompts；off=只剩题库与补拍两路（回滚口）。模型同 CABINHUG_ANSWER_MODEL。
# SERVICE_ASKS_GRACE_MS=3000    # 应答说完之后最多再等提议多久（毫秒）；到点中止那次调用、按没提处理
# CABINHUG_GENERAL_SCOPE=on      # general 路由的作答范围说明：写代码 / 代写 / 长文翻译 / 与车无关的专业意见婉拒并引回用车，
#                               #   其余照常答；只挂在落到 general 的那一路的本轮尾区，其它路由逐字不变。off=不挂范围说明（回滚口）。
# DEEPSEEK_VISION_MODEL=""      # 这一次请求带了图片（照片 / 视频帧序图）时用的视觉档，默认 deepseek-flash（ACR-027）；
#                               #   纯文字请求不用它——按请求判，不按会话钉。
#                               # deepseek-flash 是 V4.1 Flash 的正式名；旧名 deepseek-v4-flash-vision-exp 与
#                               #   预览档 deepseek-v4.1-flash-expires-on-0910 都只是它的别名，不要填别名：别名会被撤销，
#                               #   撤销后运行时只在「模型名不认识」这一种错误上自动退回默认档并打日志，配置仍需修改。
# CABINHUG_TITLE_MODEL=""        # 会话标题生成模型，默认 deepseek-flash
# CABINHUG_SIDE_TASKS=on        # 复合意图的副任务（ACR-023）：off=意图提示词不带 sideTasks、图只起主 lane；权限门排队不受它影响
# CABINHUG_PROBE_RATE_LIMIT=6    # 后台连通性探针限流（次/60s）
# CABINHUG_CONTEXT_LAYER=tasks   # 上下文两级状态与注入（ACR-036）。缺省 tasks，三档逐级可退：
#                               #   tasks  = 行程改读 working_tasks 的任务状态、旧通道停写（缺省）
#                               #   inject = 只装载并注入，图状态一字不动（退一档）
#                               #   off    = 不装载不注入，prompt 与不启用上下文层时逐字相同（退到底）
#                               # 从 tasks 往回退之前先跑 `corepack pnpm release:context-downgrade -- --apply`：
#                               #   tasks 期间的草案只在 working_tasks 里，直接拨回去编排层读图状态会读不到
# CABINHUG_CONTEXT_CACHE_TTL_S=60 # 用户长期状态快照的 Redis TTL（秒）。写路径会主动失效，这一项是「漏接一处」的上限
# CABINHUG_TRIP_PLAN_LAYER=plan  # 多天行程的 Plan 层（ACR-037）。缺省 plan，三档逐级可开、逐级可退：
#                               #   off    = 不运行 Plan 层，fan-out 走旧路径；要退回旧路径就显式设它
#                               #   plan   = 编排层先搜景点、按坐标聚成天×片区、tour-plan-task 语义裁决，四条腿读骨架
#                               #   review = 再把装配 / 体检 / 修复切到 trip-review-task
# CABINHUG_TRIP_CLARIFY=on       # 出行需求澄清门（ACR-039）：骨架轮缺目的地或天数先问一句再排，同一会话只问一次；off = 不澄清直接排

# 会话空闲多久算结束。默认 30 分钟；空闲超过它之后再发消息会拿到
# 409 session_expired，端上据此开新会话。软关闭，历史不删。
# 配成 0 或负数会回落默认值，避免每条消息都被判过期。
CABINHUG_SESSION_IDLE_MIN=30
# 账号级事件通道总开关（ACR-031）。默认开。
# 开着时网关在「消息落库 / 标题落库 / 关闭会话」三处向 GET /v1/events 广播一条
# 「你的会话列表变了」，同一个人的其它端据此重拉列表；关闭时手机端的对话
# 不会出现在车机端的会话列表里。
# 置 false 时路由回 503、发射点短路，等于这条通道不存在（不用发版的回滚手段）。
ACCOUNT_EVENTS_ENABLED=true
# 模拟经销商系统。它是开发期的假第三方，不是基础设施依赖：
# 关掉它用于演示降级（上游如实说"门店系统没连通"，而不是继续报门店名）。
MOCK_DEALER_PORT=8792
MOCK_DEALER_URL="http://localhost:8792"

# 模拟车机舒适域（座舱）。与 mock-dealer 定位相同：假第三方、可当场 kill 演示降级。
# 只有设置值（空调 23 度、座椅加热 2 档），不认识人——偏好归 Agent 侧管理。
MOCK_CABIN_PORT=8793
MOCK_CABIN_URL="http://localhost:8793"

# 模拟 4S 维修系统。定位相同：假第三方、关掉它用于演示降级
# （上游如实说"维修系统没连通"）。历史维修记录/预约维修/维修中报价单三域，
# 种子与 demo:seed 的两辆演示车按 VIN 对齐。8796 被 worker 探活占用，故 8797。
MOCK_REPAIR_PORT=8797
MOCK_REPAIR_URL="http://localhost:8797"

# 模拟保险系统。保单查询 + 按维修报价单理赔预检（确定性测算、
# 响应自带免责与规则自述）。与 mock-repair 互不调用，组合在工具层。
MOCK_INSURANCE_PORT=8798
MOCK_INSURANCE_URL="http://localhost:8798"

# ── worker 定时任务的探活端点
# 只读，不接受任何触发动作——手动跑任务走 `--once`，那是有副作用的命令行操作。
# 它回答的是"worker 进程此刻在不在"；"任务最近跑过没有"仍由 job_runs 留痕回答。
# 缺了这两个值也不影响任务执行，只影响 /system 那张卡：端口探不到就退回留痕，
# 而留痕的粒度是小时级 cron，刚起的 worker 会显示为「未启用」。
WORKER_HEALTH_PORT=8796
# 探活端口只绑这个地址（ACR-062）。不设 = 所有网卡；单机版由宿主设 127.0.0.1。
# WORKER_HEALTH_BIND=127.0.0.1
WORKER_HEALTH_URL="http://localhost:8796"

# ── 旁路闲聊 Agent（US-45）：等待期的语音填充。默认关
# 它不降低真实时延，只改变等待期的信息状态。全部为策略值（C 类），可热调。
# SIDECAR_ENABLED=1           # 总开关；不置位即整条旁路不建对象、零开销
# SIDECAR_SILENCE_MS=1500     # 静默多久算该说句话。1500 是单样本初值，
#                             #   架构 §13-14 要求用 probe:latency 的 P50~P90 定值，
#                             #   复核前不作为结论
# SIDECAR_MIN_GAP_MS=500      # 两句之间的最小间隔，从上一句估算念完起算，
#                             #   不是从发出起算（否则长句会在播报中途被下一句截断）。
#                             #   所以调小它不会让句子互相打断——播报时长始终在前。
#                             #   重试退避不跟这个值走，有 2 秒地板（见 budget.ts）
# SIDECAR_SPEECH_MS_PER_CHAR=200  # 播报时长估算。服务端拿不到端上的播完回执，
#                             #   也不为此加一条上行通道。中文 TTS 约 4~5 字/秒
# SIDECAR_TICK_MS=700         # 重新判定的节拍。span 在完成时才落，
#                             #   检索期间轨迹侧没有事件，纯事件驱动会静默
# SIDECAR_FILLER_MODEL=deepseek-v4-flash  # L1 导游用的模型。钉死非推理模型：
#                             #   跟随 DEEPSEEK_MODEL 时填充句本身也要思考十几秒，
#                             #   失去快速填充的意义
# SIDECAR_FILLER_TEMPERATURE=1.0  # 导游的采样温度。不传温度时输出是确定性的：
#                             #   同一个地名多次询问返回同一句，
#                             #   prompt 里写"换个角度"也无效。1.3 起会开始
#                             #   编造街道名与地方特产，所以取 1.0（实测 3 档 × 30 句）
#
# 不设单轮条数上限与总时长上限（SIDECAR_MAX_PER_TURN / SIDECAR_MAX_TOTAL_MS 已移除）：
#    turn 何时结束由会话超时负责，旁路的生命周期绑在 turn 上。
#    总上限短于 fan-out 的 60 秒汇聚超时，会让长等待被提前截断。

# ── 端上鉴权（FL-07 F-07-01/02）
# JWT 签名密钥：至少 16 字符。
#   · 开发（NODE_ENV != production）：留空即用内置默认密钥 DEV_JWT_SECRET
#     （定义在 enterprise/backend/shared/db/src/config/registry.ts，仓库里唯一一份字面量），
#     每次启动打一行告警。这是为了让新克隆的仓库直接启动，不代表可以不配。
#   · 生产（NODE_ENV=production）：不提供默认值，缺失即启动失败。
#     写在公开仓库里的签名密钥等于没有鉴权，且不会以任何异常暴露
#     （token 照常签发、照常通过）。
# 这里保持留空，避免本机 .env 复制后把开发默认值固化成一份副本。
# 生成：openssl rand -hex 32
CABINHUG_JWT_SECRET=""
# 开发账号口令（仅本机）：迁移种下的 demo-user 是锁定账号（散列 `!`），
# 用 `corepack pnpm --filter @cabinhug/gateway seed:dev-credentials` 给它设口令。
# 缺省 carlife-dev。生产账号走 POST /console/users（admin token），不用这个。
CABINHUG_DEV_PASSWORD=""

# ── 后台
# 角色 token：与端上 JWT 是两条互不影响的鉴权路径。
# POC 简化形态，退出条件见 enterprise/backend/gateway/src/auth/console.ts（FL-07 F-07-01）。
CABINHUG_ADMIN_TOKEN="admin-token"
CABINHUG_OPS_TOKEN="ops-token"
# 配置加密主密钥（§13-12）：至少 16 字符，不与密文同库，缺失即启动失败。
# 生成：openssl rand -hex 32
CABINHUG_CONFIG_MASTER_KEY=""
# PII 落盘加密主密钥：车辆成员的联系人字段（称呼/关系/备注/手机号）
# AES-256-GCM 加密落库、读取透明解密。与配置主密钥是独立的两把钥匙（轮换周期
# 与泄露影响面不同），同样至少 16 字符、不与密文同库、缺失即启动失败。
# 存量数据迁移：corepack pnpm --filter @cabinhug/db db:pii:encrypt（幂等可重跑）
# 生成：openssl rand -hex 32
CABINHUG_PII_MASTER_KEY=""

# 配置缓存 TTL（毫秒，默认 30000）。改配置后最长等这么久生效；e2e 用短值。
# CABINHUG_CONFIG_TTL_MS=30000
# Fake 模型回复前缀（仅离线开发可见，用于验证配置热生效路径）
# CABINHUG_LLM_FAKE_TAG=""
# DeepSeek 模型与端点（可在后台热改，此处为兜底默认）
# DEEPSEEK_MODEL="deepseek-flash"      # V4.1 Flash 正式名；旧名 deepseek-v4-flash 只是它的别名，不要填
# DEEPSEEK_BASE_URL=""
# 目的地推荐的联网搜索：走 DeepSeek 的 Anthropic 兼容端点声明服务端工具
# web_search，与上面那条 OpenAI 兼容路径是两条独立链路，所以模型名也分开配，
# 对话模型的调整不影响搜索。
# 密钥复用 DEEPSEEK_API_KEY；不配这两项就用下面的默认值。
# DEEPSEEK_ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
# DEEPSEEK_SEARCH_MODEL="deepseek-v4-flash"
# 导览采集任务队列（ACR-008，pg-boss）：on 时行程确认后自动逐景点后台采集。
# 费用：每个景点最多 3 次按次计费联网搜索（24h 缓存 + 单飞封顶）。
# 缺省关——关着时零行为变化（不加载 pg-boss、不建 pgboss schema、不入队）。
# GUIDE_QUEUE="on"
# 导览简报的保鲜期（天，ACR-065）：PG 里的简报超过这么多天视同没有，再点或预采集时重采覆盖。
# 缺省不设 = 永久（每个景点只采一次，重采只走「重新采集」）。单机版设 14，与⑤缓存的导览 TTL 同值。
# GUIDE_BRIEF_TTL_DAYS=14
# 行程骨架轮的补能评估分支（ownership-task，ACR-065）：off 时不发，只跑 drive / hotel / tour / transit 四条。
# 缺省开。单机版没有车辆档案，设 off。
# CABINHUG_TRIP_ENERGY_BRANCH=off
# 本人费用明细接口 GET /v1/billing（ACR-066）：本人会话的模型用量与审核次数、高德今日额度、DeepSeek / 阿里云账户余额。
# 缺省关（路由不存在，404）；只有单机版配置设 on。余额是账户的财务信息，容器部署不要开，那边看控制台财务页。
# CABINHUG_OWNER_BILLING=on
# LLM 成本估算单价（元/1K token，可在后台热改）
# LLM_PRICE_PROMPT_PER_1K="0.003"
# LLM_PRICE_COMPLETION_PER_1K="0.009"
# TTS_PRICE_PER_10K_CHARS="6.5"
# ASR_PRICE_INPUT_PER_1K="0.003"
# ASR_PRICE_OUTPUT_PER_1K="0.002"
# 对话历史保留天数；0 = 长期保留（F-03-11）
# HISTORY_RETENTION_DAYS=0
# 会话自动清理天数；0 = 关。软删除：只写 sessions.deleted_at，控制台可恢复（F-03-11）；演示环境设 1
# SESSION_AUTO_CLEAN_DAYS=0

# 工具层 Mock 三态（real / mock / off）——见 enterprise/backend/shared/tools/src/external.ts
CABINHUG_TOOLS=real

# 能力开关（ACR-056 / ACR-059）：要关闭的能力，逗号分隔；不设 = 都不关。
# 可选 photo-diagnosis（照片与视频进对话）/ ownership-qa（用车问答）/ service-qa（售后问答与维修预约）/
# buying-advice（购车顾问）/ test-drive（试驾预约）/ cabin-control（座舱控制与车内媒体）/ voice（语音识别与播报）。
# 关闭后路由回固定话术，只服务于这些能力的工具从模型手里剔除，语音的上传、转写与播报网关直接拒。
# 设在这里即钉档，后台改不回来；单机版（ARCH-002）七项全关，只留行程。
# CABINHUG_CAPABILITIES_OFF=

# 内容审核（§8.2）。默认走阿里云 AI 安全护栏（TD-04）；
# 保留 openai-compat 以便换回自建/本地模型：审核层是安全边界，
# 不绑定单一供应商的可用性。
GUARD_PROVIDER=aliyun

# 阿里云 AI 安全护栏（green-cip）。AccessKey 需 RAM 授权 AliyunYundunGreenWebFullAccess。
# 某个防护维度是否参与检测由阿里云控制台决定，不由本仓的策略开关决定：
#    后台打开 sensitiveData 而控制台未开时，配置显示开启但实际不检测。
#    用 `corepack pnpm probe:aliyun-guard` 看本账号实际生效哪几个维度。
ALIYUN_GUARD_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com
Aliyun_AccessKey_ID=
Aliyun_AccessKey_Secret=
# 实测：sensitiveData（敏感内容检测）只在 _pro 版返回；关掉 pro 时控制台开启的该维度不生效
ALIYUN_GUARD_PRO=true
ALIYUN_GUARD_TIMEOUT_MS=5000

# 自建 / 本地审核模型（GUARD_PROVIDER=openai-compat 时生效）。
# GUARD_BASE_URL 留空 = 审核层未接入（规则筛与脱敏仍生效，且结果标注未审核）
GUARD_MODEL=qwen3guard-gen
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_TIMEOUT_MS=10000

# 裁决审计落库（guard_audit_logs 表；追加式，含放行）。
# GUARD_AUDIT_PERSIST=0 时退回内存（重启即丢）——仅离线/演示用，生产不关。
GUARD_AUDIT_PERSIST=1
# allow 放行记录的采样率（0~1，默认 1 全量）。deny/needs_confirmation 永远全量落，
# 被采样掉的 allow 仍进内存 sink（误伤样本审查的数据源不能采丢）。
GUARD_AUDIT_SAMPLE_ALLOW=1

# Mem0 记忆存储（§7 ②③⑥）
#
# 没有 MEM0_URL：mem0ai 的 TS OSS 形态是进程内库，不是服务。
# 要配的只有两个后端——向量库落哪、embedding 用谁。
#
# pgvector = 复用现有 PG（§13-11 方案 A），备份归入同一条 pg_dump。
# 改成 memory 会落到本地 sqlite 文件，那份数据在备份面之外，仅供离线实验。
MEM0_VECTOR_PROVIDER=pgvector
MEM0_COLLECTION=cabinhug_memories
# 留空则回落到 DATABASE_URL（同一台 PG）
MEM0_DATABASE_URL=
# embedding 缺省走 DashScope 的 OpenAI 兼容口 + text-embedding-v4：DeepSeek 没有 embedding 接口，
# 所以这条不能复用 LLM 端点。记忆正文会出网到阿里云——与护栏 / ASR / TTS 同一供应商。
# key 留空回落 DASHSCOPE_API_KEY。换模型必须同步改 DIMS（text-embedding-v4 可选 64–2048）。
# 要不出网：PROVIDER=ollama、BASE_URL=http://localhost:11434、MODEL=nomic-embed-text、DIMS=768，
# 前置 `ollama pull nomic-embed-text`。
MEM0_EMBEDDING_PROVIDER=openai
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBEDDING_MODEL=text-embedding-v4
MEM0_EMBEDDING_DIMS=768
# mem0ai 自带的 PostHog 遥测：开着时每次记忆读写都 await 一次出网，2 ms 的列举变 300+ ms。缺省关。
MEM0_TELEMETRY=false

# RAGFlow Cloud（§6）。本仓不自建向量库，检索全托管。
# 留空 = 未接入：双路检索只剩⑥那一路，回答会显式标注"本次未引用说明书出处"。
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
# 四个数据集 id 分开配——隔离靠 id 在调用层强制，不靠 prompt
RAGFLOW_DATASET_VEHICLE_MANUALS=
RAGFLOW_DATASET_REPAIR_KB=
RAGFLOW_DATASET_CAR_CATALOG=
# 车险条款与理赔指引（ACR-040）：售后与购车两边都查；留空只影响这一集
RAGFLOW_DATASET_INSURANCE_KB=

# 天气基础预报供应商（ACR-052）：qweather（缺省）/ amap / open-meteo，显式选、不静默兜底。
# 和风天气免费额度内允许商用，但显示天气的界面必须署名「和风天气」并链接官网（端上已按此署名）；
# 高德天气与 Open-Meteo 的免费用途都限非商业，只在本地开发时选。选中的那家没配 key = 天气未接入。
WEATHER_PROVIDER=
# 和风天气：https://console.qweather.com。API Host 是账号专属的（设置 → API Host），
# 公共域名 api.qweather.com 自 2026 年起逐步停用；key 经请求头 X-QW-Api-Key 发送。
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 高德开放平台（§5 工具表「地图 API」）。https://console.amap.com
# 两把 key 属于两种应用类型，不能互换：Web 服务 key 在浏览器里调会被拒，
# Web 端(JS API) key 在服务端调同样不行。填错的表现是 infocode=10009/10001。
#
# 服务端：map_route 路径规划，以及 WEATHER_PROVIDER=amap 时的天气。留空 = map_route
# 明确返回未接入；天气是否走高德由下方 WEATHER_PROVIDER 决定，不退回 Open-Meteo（ACR-052）。
AMAP_SERVER_KEY=
# 第二个账号的 Web 服务 key（可选）。并发与月配额都按账号算——infocode 10021 的
# 原文是「账号使用某个服务接口 QPS 超出限制」，所以同一个账号下再加 key 没有用，
# 必须是另一个开发者账号。配上之后闸门给它一条独立车道，持续速率与搜索月配额都翻倍。
# 这把 key 的「数字签名」要在控制台关掉：本仓不做 sig 签名，开着会一律
# 返回 infocode=10008（MD5 安全码未通过验证），这条车道的请求全部失败。
AMAP_SERVER_KEY_2=
# 第 3~10 个账号，同上（key 池最多 10 把，清单由 `@cabinhug/tools` 的 AMAP_KEY_MAX 生成，
# 注册表与本模板都以它为准）。车道数 = 账号数，速率与搜索日配额按账号数成倍；
# 空位允许跳过（去掉 _2 不必把 _3 挪上来），同一把 key 配两次只算一条车道并告警。
# 每把 key 的用量按指纹记在台账里（Redis，缺 REDIS_URL 时仅进程内）：`corepack pnpm probe:amap` 与后台财务页可看。
AMAP_SERVER_KEY_3=
AMAP_SERVER_KEY_4=
AMAP_SERVER_KEY_5=
AMAP_SERVER_KEY_6=
AMAP_SERVER_KEY_7=
AMAP_SERVER_KEY_8=
AMAP_SERVER_KEY_9=
AMAP_SERVER_KEY_10=
# 各接口族的每把 key 日预算，格式 `place=450,direction=0`（0 或不写 = 不设限）。
# 族名：place（POI 搜索）/ geocode / regeo / district / direction / transit / weather。
# 一把 key 某族到九成就不再接该族请求（换到用量占比最低的那把）；全部到顶仍能发但告警——预算是路由偏好，
# 不是拒绝服务，10044 仍是最后一道。缺省 place=450（实测每把 key 约 450 次搜索后返回 10044）。
AMAP_DAILY_BUDGET=
# ── 财务页（后台 /finance，admin 独有）：外部账户余额与订阅状态
#
# 火山引擎费用 OpenAPI（QueryBalanceAcct）只认账号级 AK/SK 签名，
# 上面那把 ARK_API_KEY 是方舟的模型调用凭据，查不了余额，两者不能互相替代。
# 取 AK/SK：https://console.volcengine.com/iam/keymanage/
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# 阿里云余额复用内容审核那对凭据（Aliyun_AccessKey_ID / Aliyun_AccessKey_Secret，见下）。
# DeepSeek / RAGFlow / 高德复用各自已有的 key，无需再配。
#
# 余额预警阈值与缓存。高德那条探针本身要消耗当日免费额度，
# 所以默认使用 60s 缓存，避免这一页消耗额度。
# CABINHUG_FINANCE_WARN_CNY=50
# CABINHUG_FINANCE_DANGER_CNY=10
# CABINHUG_FINANCE_TTL_MS=60000
# CABINHUG_FINANCE_TIMEOUT_MS=12000
# 账单缓存单独一条且长得多：账单是已结算的历史，不会按分钟变化，
# 而拉一次要按账期调用 3 次上游；若与余额同用 60s，在卡片间来回切换会打满上游。
# CABINHUG_FINANCE_BILLS_TTL_MS=600000
# 快照落盘位置（缓存不是账本，丢了无损失）。重启后页面先秒开上次的样子再后台刷新。
# CABINHUG_FINANCE_STATE_FILE=var/finance-cache.json   # 相对网关进程 cwd（pnpm 启动时为 enterprise/backend/gateway/）
# 余额的采样历史（卡片下方那条 7 天曲线）。与上面的缓存分两个文件：缓存丢了下次采集就有，
# 历史丢一个周期就永远少一个周期。网关内的定时器每个周期采集一轮来喂它。
# 周期是唯一的旋钮：桶宽、接口下发的 stepMs、页面上"每 N 分钟采样一次"那句话都由它推。
# 代价按周期算：10 分钟 = 每天 144 轮上游调用（含高德那条消耗当日额度的探针）；
# 调成 60 就回到每天 24 轮。取值夹在 [1, 1440] 分钟，填 0/负数/非数字一律退回默认 10。
# CABINHUG_FINANCE_HISTORY_INTERVAL_MIN=10
# CABINHUG_FINANCE_HISTORY=off                             # 定时器与记点一起停
# CABINHUG_FINANCE_HISTORY_FILE=var/finance-history.json   # 同样相对网关进程 cwd

# 客户端：车机 HUD 的真实地图底图。留空 = 回退程序化 SVG 底图（离线也是这条路径）。
# 它随前端产物下发且无法避免——加载 SDK 的 script 标签必须带它。
# 安全性靠高德控制台的域名白名单，不靠保密。
AMAP_JS_KEY=
# JS API 安全密钥——服务端配置，端上不读（ACR-019）。
# 网关的 /_AMapService/* 代理在转发时追加它（enterprise/backend/gateway/src/http/amap-proxy.ts），
# 前端只知道代理地址，它不进入前端产物。
AMAP_JS_SECURITY_CODE=
# 中国气象局天气增强。无 key，大陆可达，默认开。
# 它补的是高德给不了的：体感温度、湿度、降水实况、气压、风、气象预警，
# 并把预报窗口从高德的 4 天拉到 7 天。紫外线指数与能见度它也没有。
# 置 off 可一键关掉（接口是公开网页的内部接口，改版失效时用它止血）。
# CABINHUG_WEATHER_CMA=on
# vite 只把 VITE_ 前缀的变量注入前端产物，所以两个端要在 .env 里另给一份
# 同值的 VITE_AMAP_JS_KEY（构建期注入，不是运行时配置项，故不进配置注册表）。
# VITE_AMAP_JS_SECURITY_CODE 已退役（ACR-019）：安全密钥不进产物，
# 端上只知道网关代理地址。.env 里若还留着这一行，它不被任何代码读取，可以删除。

# 对象存储（§9）。附件桶与知识库分开——用户上传的内容不进知识库。
# 留空 = 上传未接入（接口明确返回未接入，不假装成功）。
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY_ID=carlife
S3_SECRET_ACCESS_KEY=carlife-secret
S3_BUCKET=carlife-attachments

# 视频附件的解析（ACR-027）：网关用宿主的 ffmpeg 抽帧成帧序图、切音轨分段转写。
# 留空 = 用 PATH 上的 ffmpeg / ffprobe。macOS 上 brew 同时装了 ffmpeg 与 ffmpeg-full 时 PATH 常指向后者，
# 而后者缺 dylib 时会报 `Library not loaded: libvpx`——那时钉到 /opt/homebrew/bin/ffmpeg。
# 不可用不阻塞启动：视频照收照绑，模型会如实说"这次没看成视频"。
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=                       # 缺省按 FFMPEG_PATH 同目录推

# MinerU（PDF 版面解析）。多栏 PDF 必须经它转换：
# RAGFlow 的 DeepDOC 会把三栏按行横向串读，错误结果带着出处，表面正常。
# 留空则只能传单栏 PDF。
MINERU_API_TOKEN=

# ── ⑤环境缓存（§7⑤）。Redis 见 infra/docker-compose.yml（宿主端口 56379）。
# 未配置即不缓存——天气与路线全部直连上游，功能不受影响，只是慢且费配额。
REDIS_URL=redis://localhost:56379
# 单机版（ACR-064）：没有 Redis 时⑤缓存与高德额度台账落这个 SQLite 文件，由单机宿主注入数据目录下的路径。
# 配了 REDIS_URL 时不看它；容器部署与开发机不用设。
# CABINHUG_CACHE_SQLITE=

# ── iOS 构建签名（仅本机需要，不入库）。tauri.conf.json 不写死 developmentTeam，
# Apple Team ID 走环境变量注入（tauri ios init / build 均读取）：
# TAURI_APPLE_DEVELOPMENT_TEAM=""


# ── 行程可执行性体检（FL-58）。四个都是产品口径，默认值来源见 agent-runtime/src/graph/audit-config.ts。
# 修复循环最多几轮 / 总预算毫秒（预算耗尽按"未消解"交付，不无限循环）
CABINHUG_PLAN_AUDIT_MAX_ROUNDS=3
CABINHUG_PLAN_AUDIT_BUDGET_MS=90000
# 连续几轮没压下 blocker 就停手。不要调成 1：离线复算 44 个 turn
# （scripts/dev/check/replay-audit-rounds.mts），「不降即停」让其中 18 个的
# 最终结果比跑满更差——先变差再变好是这条链路的常态。
CABINHUG_PLAN_AUDIT_STALL_ROUNDS=2
# 全天累计行车上限 / 安全单段上限（分钟）；同行者的单段上限来自对话约束，两者取更严
CABINHUG_DRIVE_DAILY_MAX_MIN=540
CABINHUG_DRIVE_LEG_SAFE_MAX_MIN=180
# 住宿片区缺口的距离阈值（公里）：当天景点与酒店候选最近超过它才追发 hotel 补候选。
# 缺省 8 由真跑数据标定（覆盖的天 ≤2.1km、真缺口 ≥8.1km）；
# 调整时用新一批真跑重新标定，标定方法见 itinerary.ts 的 HOTEL_GAP_KM_DEFAULT。
CABINHUG_HOTEL_GAP_KM=8


# ── 用户研究面（ACR-034）。两个开关缺省关闭，关闭时既有行为不变：
#   RESEARCH_ENABLED 决定 worker 挂不挂取数任务，RESEARCH_RUNTIME_URL 决定网关代不代理。
# RESEARCH_ENABLED=off               # on | off；on 才按小时窗切证据单元
# RESEARCH_RUNTIME_URL=""            # 空 = 未启用（网关回 503 research_not_configured，五页显示「本部署没有研究面」）；
#                                    #   起了就填 http://localhost:8800。服务无鉴权且只绑 127.0.0.1
# RESEARCH_RUNTIME_PORT=8800         # 8790–8799 已被占，研究服务取 8800
# RESEARCH_EMBEDDING_MODEL="text-embedding-v4"  # 百炼，走 DASHSCOPE_API_KEY
# RESEARCH_EMBEDDING_DIM=1024        # 改它要同时改迁移里的 vector(1024)；上限 2000（pgvector ANN 索引上限，ACR-030）
# RESEARCH_MIN_CELL_VEHICLES=10      # 小单元抑制阈值（台车）。低于它的格清空明细——这是权利决定不是显示偏好
# RESEARCH_CODER_MODEL="deepseek-flash"  # 编码 Agent。思考必须显式关（开启时实测思考 49 秒、18253 字，一个字段没填）
# RESEARCH_SYNTH_MODEL="deepseek-v4-pro"  # Synthesizer / Challenger / Namer。裸 "deepseek" 不是合法模型名，供应商回 400
# RESEARCH_CHALLENGER_TRANSPORT=acp   # acp | direct。Challenger 探查跳走 pi/ACP 底座（缺省，ACR-038）还是 AI SDK 直连；
#                                     #   回滚 = 把这一行设成 direct，不用回代码。认不出的值按缺省 acp 跑并 warn
# RESEARCH_CHALLENGER_ACP_TIMEOUT_MS=180000  # acp 下一次探查的上限；超时按「步数已用满」处理，仍进收口跳（宁出 inconclusive 不丢卡）
# ── 构建期 npm 源（可选，缺省留空 = 官方源）
#
# 只在 docker 构建镜像时用，应用运行期不读它。国内 ECS 直连 registry.npmjs.org
# 实测约 13.7 KB/s，镜像站约 11.3 MB/s。
# 与 Docker Hub 的 registry-mirrors 是同一个思路，只是那个写在 /etc/docker/daemon.json。
#
# 留空就是官方源——本机开发与 CI 不受影响。部署到国内机器时填：
#   NPM_REGISTRY=https://registry.npmmirror.com
# 换源不放松完整性：业务镜像走 pnpm install --frozen-lockfile，pnpm-lock.yaml 里
# 逐包的 integrity 哈希照样校验。四个 mock 无 lockfile，但依赖只有 tsx 与 typescript。
NPM_REGISTRY=
# ── 构建期 pip 源（可选，缺省留空 = 官方 PyPI）。同一个思路，只有 vision-infer 这一个 Python 镜像用（ACR-050）。
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 换源不放松完整性：镜像按 requirements.lock.txt 装并校验内容哈希（pip --require-hashes）。
# 镜像源有同步延迟：锁文件里出现镜像上还没有的最新版会直接装不上——vision-infer 的 pyproject 用
#   [tool.uv] exclude-newer 只锁发布满两周的版本，升级依赖时不要把那个日期改成当天。
PIP_INDEX_URL=
