{
  "name": "cabinhug",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "^9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build:all": "corepack pnpm check:node && corepack pnpm turbo run build && cargo build --workspace",
    "build:cockpit": "corepack pnpm check:node && corepack pnpm turbo run build --filter @cabinhug/cockpit && cargo build -p cockpit",
    "build:mobile": "corepack pnpm check:node && corepack pnpm turbo run build --filter @cabinhug/mobile && cargo build -p mobile",
    "build:packages": "corepack pnpm check:node && corepack pnpm turbo run build --filter \"./contracts\" --filter \"./clients/shared/*\" --filter \"./enterprise/backend/shared/*\"",
    "build:rust": "cargo build --workspace",
    "build:services": "corepack pnpm check:node && corepack pnpm turbo run build --filter \"./enterprise/backend/*\"",
    "build:web": "corepack pnpm check:node && corepack pnpm turbo run build --filter @cabinhug/web",
    "build": "corepack pnpm check:node && corepack pnpm turbo run build",
    "bundle:cockpit": "corepack pnpm check:node && corepack pnpm --filter @cabinhug/cockpit tauri build",
    "bundle:mobile": "corepack pnpm check:node && corepack pnpm --filter @cabinhug/mobile tauri build",
    "build:cockpit-ios": "corepack pnpm check:node && corepack pnpm turbo run build --filter @cabinhug/cockpit && cargo build -p cockpit --lib --target aarch64-apple-ios",
    "bundle:cockpit-ios": "corepack pnpm check:node && PATH=\"$PWD/scripts/dev/bin:$PATH\" corepack pnpm --filter @cabinhug/cockpit tauri ios build",
    "build:mobile-ios": "corepack pnpm check:node && corepack pnpm turbo run build --filter @cabinhug/mobile && cargo build -p mobile --lib --target aarch64-apple-ios",
    "bundle:mobile-ios": "corepack pnpm check:node && PATH=\"$PWD/scripts/dev/bin:$PATH\" corepack pnpm --filter @cabinhug/mobile tauri ios build",
    "check:all": "corepack pnpm check:node && corepack pnpm check:env-example && corepack pnpm check:secrets && corepack pnpm check:orphan-commands && corepack pnpm check:arch && corepack pnpm check:versions && corepack pnpm test:contract && corepack pnpm test:rust && corepack pnpm test && corepack pnpm test:infra",
    "check:arch": "tsx scripts/dev/check/check-arch-invariants.ts",
    "check:env-example": "tsx scripts/dev/check/check-env-example.ts",
    "check:node": "bash infra/scripts/dev-node-check.sh",
    "check:orphan-commands": "tsx scripts/dev/check/check-orphan-commands.ts",
    "check:secrets": "tsx scripts/dev/check/check-secrets.ts",
    "check:versions": "tsx scripts/dev/check/check-client-versions.ts",
    "release:context-downgrade": "tsx scripts/dev/release/context-layer-downgrade.mts",
    "release:client": "tsx scripts/dev/release/release-client.ts",
    "release:standalone-postgres": "node scripts/dev/release/build-standalone-postgres.mjs",
    "coverage:js": "corepack pnpm check:node && tsx scripts/dev/check/coverage-js.ts",
    "titles:backfill": "tsx infra/scripts/backfill-session-titles.ts",
    "trips:review-backfill": "tsx infra/scripts/backfill-trip-plan-reviews.ts",
    "demo:reset": "tsx scripts/dev/demo/demo-seed.ts --reset",
    "demo:seed": "tsx scripts/dev/demo/demo-seed.ts",
    "demo:fault-inject": "tsx scripts/dev/demo/fault-inject-demo.ts",
    "demo:media": "tsx scripts/dev/demo/gen-demo-media.mts",
    "demo:music": "tsx scripts/dev/demo/fetch-demo-music.mts",
    "demo:verify": "tsx scripts/dev/demo/demo-verify.ts",
    "demo:status": "tsx scripts/dev/demo/demo-seed.ts --status",
    "db:test:setup": "corepack pnpm --filter @cabinhug/db db:test:setup",
    "dev:infra-down": "bash infra/scripts/dev-infra.sh down",
    "dev:infra-restart": "bash infra/scripts/dev-infra.sh restart",
    "dev:infra-up": "bash infra/scripts/dev-infra.sh up",
    "dev:asr:setup": "corepack pnpm check:node && node --env-file-if-exists=.env infra/scripts/whisper-model-setup.mjs",
    "dev:bootstrap": "bash infra/scripts/dev-bootstrap.sh",
    "dev:upgrade": "bash infra/scripts/dev-upgrade.sh",
    "dev:readiness": "corepack pnpm check:node && node infra/scripts/dev-readiness.mjs",
    "dev:logs": "bash infra/scripts/dev.sh logs",
    "dev:mock-cabin": "corepack pnpm --filter @cabinhug/mock-cabin dev",
    "dev:mock-dealer": "corepack pnpm --filter @cabinhug/mock-dealer dev",
    "dev:restart": "bash infra/scripts/dev.sh restart",
    "dev:start": "bash infra/scripts/dev.sh start",
    "dev:status": "bash infra/scripts/dev.sh status",
    "dev:stop": "bash infra/scripts/dev.sh stop",
    "dev": "corepack pnpm check:node && corepack pnpm turbo run dev",
    "e2e:dualpath": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e-dualpath.ts",
    "e2e:m2-02": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e.ts",
    "e2e:m3": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e-console.ts",
    "e2e:identity": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e-identity.mts",
    "e2e:member": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e-member.mts",
    "e2e:upload": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/e2e-upload.ts",
    "eval:memory-decay": "tsx evals/memory-decay/run.ts",
    "eval:cases-doc": "tsx evals/lib/cases-doc.ts",
    "eval:figure-anchor": "tsx evals/figure-anchor/run.ts",
    "eval:kb-qdrant": "tsx evals/kb-qdrant/run.ts",
    "eval:judge-audit": "tsx evals/risk/audit.ts",
    "eval:compare": "tsx evals/lib/compare.ts",
    "eval:job": "tsx evals/lib/job.ts",
    "eval:ownership-service": "tsx evals/ownership-service/run.ts",
    "eval:trip-clustering": "tsx evals/trip-clustering/run.ts",
    "eval:research-coding": "tsx evals/research-coding/run.ts",
    "eval:risk": "tsx evals/risk/run.ts",
    "eval:scenarios": "tsx evals/scenarios/run.ts",
    "research:seed": "tsx evals/research-coding/seed.ts",
    "eval:vision-observe": "tsx evals/vision-observe/run.ts",
    "generate:contract": "TS_RS_EXPORT_DIR=../../../../contracts/src/generated cargo test -p cabinhug-core --lib export_bindings",
    "git:commit-own": "node scripts/dev/git/commit-own.mjs",
    "kb:convert": "tsx scripts/dev/kb/mineru-convert.mts",
    "kb:icons": "tsx scripts/dev/kb/icon-index-build.mts",
    "kb:figures": "tsx scripts/dev/kb/figure-index-build.mts",
    "qdrant:backup": "tsx infra/scripts/qdrant-backup.ts backup",
    "qdrant:drill": "tsx infra/scripts/qdrant-backup.ts drill",
    "kb:move": "tsx scripts/dev/kb/ragflow-move.mts",
    "kb:qa": "tsx scripts/dev/kb/ragflow-chunk-qa.mts",
    "kb:replace": "tsx scripts/dev/kb/ragflow-replace.mts",
    "kb:alerts": "tsx scripts/dev/kb/tesla-alerts-fetch.mts",
    "kb:upload": "tsx scripts/dev/kb/ragflow-upload.mts",
    "kb:wait": "tsx scripts/dev/kb/ragflow-wait.mts",
    "lint": "corepack pnpm turbo run lint",
    "probe:aliyun-guard": "tsx scripts/dev/probe/aliyun-guard-probe.mts",
    "probe:cache-ratio": "tsx scripts/dev/probe/cache-ratio-probe.mts",
    "probe:amap": "tsx scripts/dev/probe/amap-probe.mts",
    "probe:amap-proxy": "tsx scripts/dev/probe/amap-proxy-probe.mts",
    "probe:icon-embedding": "tsx scripts/dev/probe/icon-embedding-probe.mts",
    "probe:latency": "tsx scripts/dev/probe/latency-probe.ts",
    "probe:route-services": "tsx scripts/dev/probe/route-services-probe.mts",
    "probe:m21": "tsx scripts/dev/demo/m21-acceptance.mts",
    "probe:ragflow": "tsx scripts/dev/probe/ragflow-probe.mts",
    "probe:standalone-postgres": "node scripts/dev/probe/verify-standalone-postgres.mjs",
    "probe:standalone-trip": "node scripts/dev/probe/standalone-trip-smoke.mjs",
    "probe:tour-clustering": "tsx scripts/dev/probe/tour-day-clustering.mts",
    "probe:trip-live": "tsx scripts/dev/probe/trip-live-evidence.mts",
    "probe:weather": "tsx scripts/dev/probe/weather-probe.mts",
    "probe:vision-infer": "tsx scripts/dev/probe/vision-infer-probe.mts",
    "rag:eval": "tsx scripts/dev/kb/rag-eval.mts",
    "selfcheck:clean": "tsx scripts/dev/check/selfcheck.ts --clean",
    "selfcheck": "tsx scripts/dev/check/selfcheck.ts",
    "smoke:acp": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/smoke-acp.ts",
    "smoke:llm": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/smoke-real-llm.ts",
    "smoke:restart": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/smoke-restart.ts",
    "smoke:voice": "corepack pnpm check:node && tsx enterprise/backend/gateway/scripts/smoke-voice-stack.ts",
    "spike:acp": "corepack pnpm check:node && tsx enterprise/backend/agent-runtime/scripts/spike-acp.ts",
    "test:contract": "corepack pnpm check:node && cargo test -p cabinhug-core --test contract_roundtrip && tsx contracts/scripts/check-contract-fixtures.ts",
    "test:inventory": "tsx scripts/dev/check/test-inventory.ts",
    "test:infra": "corepack pnpm check:node && node --import tsx --test infra/scripts/*.test.ts scripts/dev/check/*.test.ts scripts/dev/demo/*.test.ts scripts/dev/git/*.test.ts evals/*/*.test.ts",
    "test:rust": "cargo test --workspace",
    "test:web": "corepack pnpm --filter @cabinhug/web test",
    "test": "corepack pnpm check:node && tsx scripts/dev/check/with-test-db.ts corepack pnpm -r --if-present test",
    "turbo": "PATH=\"$PWD/scripts/dev/bin:$PATH\" turbo",
    "typecheck": "corepack pnpm check:node && corepack pnpm turbo run typecheck",
    "research:embed-backfill": "tsx enterprise/backend/research-runtime/scripts/embed-backfill.ts"
  },
  "devDependencies": {
    "//workspace-scripts": "根 scripts/ 下的检查脚本 import 这三个包（check:env-example 读 CONFIG_REGISTRY 等）。根不声明它们时 pnpm 不会在根 node_modules 建链接，表现是 `Cannot find module '@cabinhug/db'`——而它只在重装依赖之后才冒出来，此前是靠一条早期布局残留的悬空链接活着的",
    "@cabinhug/db": "workspace:*",
    "@cabinhug/memory": "workspace:*",
    "@cabinhug/research": "workspace:*",
    "@cabinhug/tools": "workspace:*",
    "c8": "^12",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "yaml": "2.9.0"
  }
}
