{
  "name": "@cabinhug/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "seed:dev-credentials": "node --env-file-if-exists=../../../.env --import tsx scripts/seed-dev-credentials.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@cabinhug/db": "workspace:*",
    "@cabinhug/guardrails": "workspace:*",
    "@cabinhug/memory": "workspace:*",
    "@cabinhug/rag": "workspace:^",
    "@cabinhug/shared": "workspace:*",
    "@cabinhug/tools": "workspace:*",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.0",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
