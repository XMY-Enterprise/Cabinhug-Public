      "expected": "联系方式138****5678。"
    },
    {
      "rule": "phone",
      "shouldMask": true,
      "input": "call me at 13812345678 pls",
      "expected": "call me at 138****5678 pls"
    },
    {
      "rule": "phone",
      "shouldMask": false,
      "input": "订单号 23812345678 不是手机号",
      "expected": null
    },
