# macOS
.DS_Store

# Node
node_modules/
dist/
build/
*.log
.npm/
.pnpm-store/

# Rust / Tauri
target/
**/src-tauri/target/
# Tauri 生成目录（schemas 每次 build 重写；gen/apple 由 `tauri ios init` 生成，
# 且 Xcode 工程会写入个人签名信息 DEVELOPMENT_TEAM，整目录不入库）
**/src-tauri/gen/

# Env / secrets
.env
.env.*
!.env.example
# 部署目录中的可提交环境模板；真实 .env 仍保持忽略
!.env.*.example

# Python 虚拟环境（uv sync 生成）
.venv/

# Editor
.vscode/
.idea/

# Build output (packages emit to dist/, already covered above)
*.tsbuildinfo
.feature-deps-review.md

# 覆盖率产物（c8，ACR-009）。输出目录默认相对 cwd，仓库根与各 workspace 成员下
# 都可能出现（如 enterprise/backend/shared/memory/coverage/），所以不锚定、按目录名统一忽略。
# 带结尾斜杠只匹配目录，enterprise/backend/shared/rag/src/coverage.ts 这类源文件不受影响。
coverage/


# MinerU 转换产物（可重新生成，按量计费所以缓存）
data/kb-md/
# 同一次转换落盘的图片与块表（ACR-029，kb:figures 的输入）：几百张 jpg，与 kb-md 同一条纪律
data/kb-figures/
# ⚠️ data/kb-src/ **不在忽略之列**：那里放的是手写的知识库源文件（没有上游 PDF，
# 重新生成不出来）。忽略掉的话，它就只存在于 RAGFlow 和某个人的本地磁盘上。

# Qdrant 快照备份（一份 86 MB 起，且能从 Qdrant 服务重新打）
data/backups/

# Mem0 的运行时产物（historyDbPath 默认相对 cwd，谁先跑就落在谁的目录下）
**/data/mem0-history.db
**/data/mem0-vector.db

# 本地 dev 服务日志（infra/scripts/dev.sh）
.dev-logs/
.turbo/

# 生成脚本旁的 work/ img/ media/ 是模板拆包、截图与中间产物，不入库

# 且赛方相册还在持续更新——图片不入库，入库的是能原样重建它们的三份小文件
# （分类规则.json / manifest.jsonl / README.md，由 生成脚本/live_photos.py 维护）


# 模拟车机的运行时状态快照（mocks/cabin/src/persistence.ts）。
# 它是"这辆演示车现在被设成什么样"，属于运行产物不是源码；
# data/ 里的 models.json 是种子数据，仍然入库——两者刻意分开放。
# 状态文件落在进程 cwd 下（仓库根 / 各服务目录都可能出现），且 gateway 的
# finance-cache.json 等也遵循同一约定，所以不锚定、按目录名统一忽略。
var/

# playwright-cli 的调试快照与控制台日志（page-*.yml / console-*.log，逐次运行生成）
.playwright-cli/

# 浏览器验证截图输出（可随时重新截，不入库）
/output/

# doc-writing 技能评测预览服务器的本地运行产物

# 评测任务目录（M67）：控制台 / 编排器起的任务产物，不提交；仓库里提交的基线在 evals/runs/ 顶层
evals/runs/jobs/
# 检测器训练产物与数据集（ACR-026）：目录即真相，内容不提交，各留 README
evals/runs/vision-trainer/
evals/vision-observe/datasets/*/

# pi-agents 本地运行时产物（会话记录、凭证与模型存储等）。
# 目录里只有 models.json 入库：它给 pi 的内置目录补 `deepseek-flash`（V4.1 Flash 的正式名，
# pi 0.84.1 自带目录里没有它），随仓库走才能让每台机器跑同一个模型（2026-09-15）。
enterprise/backend/pi-agents/.pi/agent/*
!enterprise/backend/pi-agents/.pi/agent/models.json

# 负样本的画框图（M80-05）：20 张一跑就是 38 MB 的可复跑诊断产物，不进仓库；
# tesla-01 那两张留着当两家的肉眼对照。
evals/runs/vision-observe-boxes/neg-*.png
# inbox-*.png 同理，且多一层理由：它们是 inbox 真车照片画框后的产物，
# 而 inbox 原图本身就因来源不明不进仓库（见本文件末尾）——画了框的版本
# 一样是那批照片，提交它等于绕过那条纪律。22 张 51 MB，可用 eval 重跑。
evals/runs/vision-observe-boxes/inbox-*.png

# 小红书等来源不明的真车截图（M80-08 之后的真题 inbox）：只做内部评测，不进仓库、不进训练集、不外发
evals/vision-observe/photos/inbox/

# 各技能 workspace 的预览服务器 pid（viewer.log 已被上面的 *.log 覆盖）。
# workspace 里的评测产物本身是入库的，只有这两个运行时文件不是。

# 仓库根的临时目录：出图中间件、截图、一次性脚本。
# scratchpad 该放会话目录，落到这里的一律是忘了清的，不入库。
tmp/

__pycache__/

# 两端的浏览器演示构建产物（ACR-049）。与 dist 分开放：原生的 tauri build 内嵌的是 dist，
# 演示构建要是也写 dist，就会把带垫片的产物嵌进原生包里。
**/dist-web/

# IP 合规审查的本机产物（策略、台账、运行记录），不入库
.ip-compliance/

# extension-env lock records machine-local marketplace paths; .extension-env is the tracked provenance record
.extension-env.lock
