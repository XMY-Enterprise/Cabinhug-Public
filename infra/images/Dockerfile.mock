# 模拟系统镜像（mocks/* 共用，ARG SERVICE 选目录名：dealer / cabin / repair / insurance）
# 假第三方住 mocks/（ACR-020），SERVICE 是那里的目录名，不带 mock- 前缀。
#
# 【为什么不进 infra/images/Dockerfile 的 workspace 分层】mock 扮演第三方系统
# （架构不变量 mock-dealer-isolation 守着不引业务包），这个隔离在部署层也成立：
# 镜像只含该服务自己的目录，不装 workspace 依赖、不随主仓 lockfile 变动重建，
# 构建秒级完成。
#
# 【为什么用 npm 而不是 corepack pnpm】服务自身的 package.json 没有
# packageManager 字段（那是仓库根的），corepack 在这里无从解析版本；
# 而 mock 的依赖只有 tsx/typescript 两个 devDep，npm 装完即用。
# 无 lockfile、版本按 ^ 区间浮动，只对模拟系统可接受。
#
#   docker build -f infra/images/Dockerfile.mock --build-arg SERVICE=dealer -t cabinhug-mock-dealer .
#   docker build -f infra/images/Dockerfile.mock --build-arg SERVICE=cabin  -t cabinhug-mock-cabin  .

FROM node:24-alpine
ARG SERVICE
WORKDIR /app

# 依赖层先行：package.json 不变时命中缓存
COPY mocks/${SERVICE}/package.json ./
# ── 构建期可换 npm 源（缺省不换）；理由与边界见 infra/images/Dockerfile 里同名的那段。
# 这里是纯 npm，不经 corepack，所以只需要 ~/.npmrc 这一处。
# mock 没有 package-lock.json，换源就没有锁文件级的完整性校验；
# 它的依赖只有 tsx 与 typescript 两个 devDep，在可接受范围内。
ARG NPM_REGISTRY=""
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi
RUN npm install --no-audit --no-fund

# 源码 + 种子数据（data/ 里的 stores.json / models.json 是服务的一部分）
COPY mocks/${SERVICE}/ ./

ENV NODE_ENV=production
CMD ["npx", "tsx", "src/main.ts"]
