# 魔搭 Docker 创空间的站点配置模板（ACR-048）。
#
# 启动时由 entrypoint.sh 用 envsubst 渲染成 /etc/nginx/conf.d/default.conf。
# 用模板而非成品：上游地址与限流阈值都来自创空间设置页的运行时环境变量，
# ECS 地址因此不进公开仓库，改限流也不必重新构建镜像。

# 按来源 IP 限速。zone 必须定义在 server 之外，所以这一段在 entrypoint 里
# 被插进 http{} 上下文（见 entrypoint.sh 对 nginx.conf 的处理）。

server {
  # 7860 是平台规定的对外端口，不可改；8080 被平台自己的进程占用，不可使用。
  listen 7860;
  # IPv6 也要听：容器内 localhost 在 Alpine 上先解析成 ::1，只听 IPv4 的话
  # 平台的健康探针会拿到 Connection refused，表现是"服务能用但显示不健康"。
  listen [::]:7860;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # 演示页只发同源 /v1/*，由这里反代到真正的网关。
  # 浏览器全程只访问魔搭的 HTTPS 域名，因此不触发混合内容阻断，网关也不需要支持 CORS。
  # 发消息单独设一道更紧的闸：一次发消息触发一整轮 LLM + 工具调用，
  # 而登录 / 拉历史只是读取。对同一会话连发 8 条消息可使 agent-runtime 退出
  # （ACP socket 上未捕获的 write EPIPE）。根因在服务端，这道闸是公开环境的兜底。
  #
  # 正则 location 优先级高于前缀 location，所以它会先于下面的 /v1/ 命中。
  location ~ ^/v1/session/[^/]+/messages$ {
    # 一分钟 16 kHz 单声道 s16le 约 1.9 MB，nginx 缺省请求体上限是 1m；
    # 不放宽时稍长的语音返回 413，端上显示"上传失败"。网关侧上限是 10mb。
    client_max_body_size 10m;
    limit_req zone=turn burst=${DEMO_TURN_BURST} nodelay;
    limit_conn demo_conn ${DEMO_MAX_CONN};
    include /etc/nginx/snippets/proxy-common.conf;
  }

  # 附件上传（照片 / 视频）。单独一条 location 只为放宽请求体上限：
  # 手机拍的一张照片 2~8 MB，nginx 缺省上限是 1m；不放宽时照片返回 413，
  # 该 413 由 nginx 返回，网关日志中没有记录。
  # 72m 与网关 `upload/index.ts` 的 BODY_LIMIT 对齐（视频白名单 64 MiB 再宽一点）；
  # 真正的格式与大小判定仍在网关，这里只保证请求到得了网关。
  location ~ ^/v1/session/[^/]+/attachments$ {
    client_max_body_size 72m;
    limit_req zone=demo burst=${DEMO_RATE_BURST} nodelay;
    limit_conn demo_conn ${DEMO_MAX_CONN};
    include /etc/nginx/snippets/proxy-common.conf;
  }

  # 其余接口：登录、建会话、开流、确认回执。
  # 浏览器全程只访问魔搭的 HTTPS 域名，因此不触发混合内容阻断，网关也不需要支持 CORS。
  location /v1/ {
    limit_req zone=demo burst=${DEMO_RATE_BURST} nodelay;
    limit_conn demo_conn ${DEMO_MAX_CONN};
    include /etc/nginx/snippets/proxy-common.conf;
  }

  # 高德服务接口的代理（ACR-019）：两端把 serviceHost 指向自己的 origin，由网关追加安全密钥。
  # 缺少这条时 try_files 返回 index.html，SDK 解析 HTML 失败：
  # 路径规划退化为直线、底图样式不生效。
  location /_AMapService/ {
    include /etc/nginx/snippets/proxy-common.conf;
  }

  # 两端的真界面（ACR-049）。入口文件叫 web.html（演示构建的入口，先装垫片再载入 main）。
  # 入口绝不缓存：旧入口指向的是上一版的哈希 JS。
  location = /mobile/web.html  { add_header Cache-Control "no-cache"; }
  location = /cockpit/web.html { add_header Cache-Control "no-cache"; }
  location ~ ^/(mobile|cockpit)/assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location /mobile/  { try_files $uri /mobile/web.html; }
  location /cockpit/ { try_files $uri /cockpit/web.html; }

  # 诊断端点：平台的边缘到底把哪些东西放进来了。
  # 只报"有没有"，不回显值：这是公网可访问的地址，回显 token 等于泄露。
  # 仅用于排查通道，排查结束后移除。
  location = /__whoami {
    default_type application/json;
    return 200 '{"header":"$has_auth_header","cookie":"$has_auth_cookie","effective":"$has_effective_auth","audioHeader":"$has_audio_header"}';
  }

  # 带哈希文件名的产物可以永久缓存——名字变了就是新文件。
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # index.html 与运行时配置绝不能被缓存：旧 index.html 指向上一版的哈希 JS，
  # 而 config.js 每次启动都可能变（设置页改了环境变量）。
  location = /index.html { add_header Cache-Control "no-cache"; }
  location = /config.js  { add_header Cache-Control "no-store"; }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
